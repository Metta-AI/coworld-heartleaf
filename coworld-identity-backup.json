{
  "$schema": "https://raw.githubusercontent.com/Metta-AI/metta/main/packages/coworld/src/coworld/coworld_manifest_schema.json",
  "tags": [
    "garden",
    "multiplayer",
    "social"
  ],
  "game": {
    "name": "heartleaf-conversations",
    "version": "0.1.3",
    "description": "Heartleaf with conversation circles and a two-step leapfrog clock: gnomes hold real turn-based conversations inside visible sparkle circles, and talking costs a fixed 4 game-minutes per line independent of model latency. Fork of coworld-heartleaf; see PR #33.",
    "owner": "alessandro.solbiati@gmail.com",
    "config_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokens"
      ],
      "properties": {
        "tokens": {
          "description": "One connection token per player seat, indexed by seat. 2-9 seats; empty houses stay closed.",
          "type": "array",
          "minItems": 2,
          "maxItems": 9,
          "items": {
            "type": "string",
            "minLength": 0
          }
        },
        "players": {
          "description": "Per-seat display names, 2-9 seats. Hosted dispatch fills each name with the policy or player behind the seat; the score panel shows it instead of player_N.",
          "type": "array",
          "minItems": 2,
          "maxItems": 9,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "seed": {
          "description": "Random seed. The hosted default 4731713 is an unpinned sentinel: the game draws a fresh seed. Pin any other integer to freeze the village RNG.",
          "type": "integer",
          "minimum": 0,
          "default": 4731713
        },
        "maxTicks": {
          "description": "Maximum simulation ticks before starting a fresh game, where 0 means no tick limit.",
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "maxGames": {
          "description": "Maximum fresh games before shutdown, where 0 means no game limit.",
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "daySeconds": {
          "description": "Real seconds per in-game day (9am to 9pm), before the 10-second score screen. 180 is the league clock: four game hours per real minute.",
          "type": "integer",
          "minimum": 30,
          "maximum": 600,
          "default": 180
        },
        "soulTimeoutSeconds": {
          "description": "Seconds the village waits after start-up for every seat's soul file before day 1 begins. A seat still missing its soul at the deadline is reported as a player failure.",
          "type": "integer",
          "minimum": 5,
          "maximum": 600,
          "default": 150
        },
        "soulConnectionRequired": {
          "description": "When true a seat whose socket drops after its soul was accepted is reported as a player failure. Off by default: the game keeps playing the gnome.",
          "type": "boolean",
          "default": false
        },
        "mockReply": {
          "description": "Offline stand-in for the model: when set, every decision is this literal reply and no model is called. Used by the certification fixture and local smoke runs only; hosted variants leave it unset so each soul's model is really called.",
          "type": "string",
          "default": ""
        },
        "maxDays": {
          "description": "Game length in days, score screens included; overrides maxTicks. The league plays 7. The game refuses a length past the 40-minute hosted deadline.",
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "results_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "day",
        "names",
        "usernames",
        "playerNames",
        "scores"
      ],
      "properties": {
        "day": {
          "description": "One-based Heartleaf day number for this score row.",
          "type": "integer",
          "minimum": 1
        },
        "names": {
          "description": "Player names in seat order.",
          "type": "array",
          "minItems": 2,
          "maxItems": 9,
          "items": {
            "type": "string"
          }
        },
        "usernames": {
          "description": "Connection usernames in seat order.",
          "type": "array",
          "minItems": 2,
          "maxItems": 9,
          "items": {
            "type": "string"
          }
        },
        "playerNames": {
          "description": "Fixed Heartleaf gnome names in seat order.",
          "type": "array",
          "minItems": 2,
          "maxItems": 9,
          "items": {
            "type": "string"
          }
        },
        "scores": {
          "description": "Cumulative player scores at the end of this day; the 9pm curfew penalty can take a score below zero.",
          "type": "array",
          "minItems": 2,
          "maxItems": 9,
          "items": {
            "type": "integer"
          }
        }
      }
    },
    "runnable": {
      "type": "game",
      "image": "coworld-heartleaf-game:coworld-c66e15490dea",
      "run": [
        "/bin/heartleaf"
      ],
      "env": {},
      "source_url": "https://github.com/Metta-AI/coworld-heartleaf/tree/674afcaacdce53c3d845b273e10aad33e712f1a5"
