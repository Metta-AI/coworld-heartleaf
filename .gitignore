# Ignore files with no extention.
*
!*/
!*.*
!LICENSE
!Dockerfile

# Ignore hidden files, but not the license or github files.
.*
!.github/
!.github/**
!.gitignore
!.dockerignore

# Normal ignores.
*.exe
nimcache
*.pdb
*.ilk
*.out
__pycache__/

# Project specific ignores.
out/
/dist/
wasm/dist/
tmp/
build/
*.dSYM/
nim.cfg
logs/
