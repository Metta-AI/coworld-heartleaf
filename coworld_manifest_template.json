{
  "$schema": "https://raw.githubusercontent.com/Metta-AI/metta/main/packages/coworld/src/coworld/coworld_manifest_schema.json",
  "tags": [
    "garden",
    "multiplayer",
    "social"
  ],
  "game": {
    "name": "heartleaf",
    "replay_viewer": {
      "bundle": "build/static-replay-viewer"
    },
    "description": "A cozy BitWorld garden dinner game where players grow food, collect vegetables, and gather in the evening. Every gnome is played by the game itself from the soul file its player uploads.",
    "owner": "treeform@softmax.com",
    "runnable": {
      "type": "game",
      "image": "{{GAME_IMAGE}}",
      "run": [
        "/bin/heartleaf"
      ],
      "source_url": "https://github.com/Metta-AI/coworld-heartleaf/tree/master",
      "env": {
        "HEARTLEAF_MOCK_REPLY": "{\"action\": \"keep_gathering_plants\"}"
      }
    },
    "config_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokens"
      ],
      "properties": {
        "tokens": {
          "description": "One connection token per player seat, indexed by seat. 2-9 seats; empty houses stay closed.",
          "type": "array",
          "minItems": 2,
          "maxItems": 9,
          "items": {
            "type": "string",
            "minLength": 0
          }
        },
        "players": {
          "description": "Per-seat display names, 2-9 seats. Hosted dispatch fills each name with the policy or player behind the seat; the score panel shows it instead of player_N.",
          "type": "array",
          "minItems": 2,
          "maxItems": 9,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "seed": {
          "description": "Random seed. The hosted default 4731713 is an unpinned sentinel: the game draws a fresh seed. Pin any other integer to freeze the village RNG.",
          "type": "integer",
          "minimum": 0,
          "default": 4731713
        },
        "maxTicks": {
          "description": "Maximum simulation ticks before starting a fresh game, where 0 means no tick limit.",
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "maxGames": {
          "description": "Maximum fresh games before shutdown, where 0 means no game limit.",
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "daySeconds": {
          "description": "Real seconds per in-game day, before the 10-second score screen.",
          "type": "integer",
          "minimum": 30,
          "maximum": 600,
          "default": 180
        },
        "soulTimeoutSeconds": {
          "description": "Seconds the village waits after start-up for every seat's soul file before day 1 begins. A seat still missing its soul at the deadline is reported as a player failure.",
          "type": "integer",
          "minimum": 5,
          "maximum": 600,
          "default": 150
        },
        "soulConnectionRequired": {
          "description": "When true a seat whose socket drops after its soul was accepted is reported as a player failure. Off by default: the game keeps playing the gnome.",
          "type": "boolean",
          "default": false
        }
      }
    },
    "results_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "day",
        "names",
        "usernames",
        "playerNames",
        "scores"
      ],
      "properties": {
        "day": {
          "description": "One-based Heartleaf day number for this score row.",
          "type": "integer",
          "minimum": 1
        },
        "names": {
          "description": "Player names in seat order.",
          "type": "array",
          "minItems": 2,
          "maxItems": 9,
          "items": {
            "type": "string"
          }
        },
        "usernames": {
          "description": "Connection usernames in seat order.",
          "type": "array",
          "minItems": 2,
          "maxItems": 9,
          "items": {
            "type": "string"
          }
        },
        "playerNames": {
          "description": "Fixed Heartleaf gnome names in seat order.",
          "type": "array",
          "minItems": 2,
          "maxItems": 9,
          "items": {
            "type": "string"
          }
        },
        "scores": {
          "description": "Cumulative player scores at the end of this day.",
          "type": "array",
          "minItems": 2,
          "maxItems": 9,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "protocols": {
      "global": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/bitworld/blob/master/docs/sprite_v1.md"
      },
      "player": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/coworld-heartleaf/blob/master/docs/soul_files.md"
      }
    },
    "docs": {
      "readme": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/coworld-heartleaf/blob/master/README.md"
      },
      "pages": [
        {
          "id": "soul_files.md",
          "title": "soul_files.md",
          "content": {
            "type": "uri",
            "value": "https://github.com/Metta-AI/coworld-heartleaf/blob/master/docs/soul_files.md"
          }
        },
        {
          "id": "models.md",
          "title": "models.md",
          "content": {
            "type": "uri",
            "value": "https://github.com/Metta-AI/coworld-heartleaf/blob/master/docs/models.md"
          }
        },
        {
          "id": "rules.md",
          "title": "rules.md",
          "content": {
            "type": "uri",
            "value": "https://github.com/Metta-AI/coworld-heartleaf/blob/master/docs/rules.md"
          }
        },
        {
          "id": "play_heartleaf.md",
          "title": "play_heartleaf.md",
          "content": {
            "type": "uri",
            "value": "https://github.com/Metta-AI/coworld-heartleaf/blob/master/docs/play_heartleaf.md"
          }
        }
      ]
    }
  },
  "player": [
    {
      "id": "shy_villager",
      "name": "Shy Villager",
      "type": "player",
      "description": "Shy Heartleaf gnome soul that gathers quietly, speaks softly, and honors party invitations.",
      "image": "{{SHY_VILLAGER_IMAGE}}",
      "run": [
        "/bin/soul_player"
      ],
      "source_url": "https://github.com/Metta-AI/coworld-heartleaf/tree/master/players/shy_villager"
    },
    {
      "id": "chatty_villager",
      "name": "Chatty Villager",
      "type": "player",
      "description": "Chatty Heartleaf gnome soul that greets everyone, talks constantly, and spreads party invitations.",
      "image": "{{CHATTY_VILLAGER_IMAGE}}",
      "run": [
        "/bin/soul_player"
      ],
      "source_url": "https://github.com/Metta-AI/coworld-heartleaf/tree/master/players/chatty_villager"
    },
    {
      "id": "friendly_villager",
      "name": "Friendly Villager",
      "type": "player",
      "description": "Friendly Heartleaf gnome soul that welcomes everyone, shares food, and hosts warm dinners.",
      "image": "{{FRIENDLY_VILLAGER_IMAGE}}",
      "run": [
        "/bin/soul_player"
      ],
      "source_url": "https://github.com/Metta-AI/coworld-heartleaf/tree/master/players/friendly_villager"
    },
    {
      "id": "fatherly_villager",
      "name": "Fatherly Villager",
      "type": "player",
      "description": "Fatherly Heartleaf gnome soul that checks on others, shares food, and makes sure nobody dines alone.",
      "image": "{{FATHERLY_VILLAGER_IMAGE}}",
      "run": [
        "/bin/soul_player"
      ],
      "source_url": "https://github.com/Metta-AI/coworld-heartleaf/tree/master/players/fatherly_villager"
    }
  ],
  "commissioner": [
    {
      "id": "default-commissioner",
      "name": "Default Commissioner",
      "type": "commissioner",
      "description": "Config-driven ruleset_strategy commissioner with shuffled_window seating and per-episode random seeds.",
      "source_url": "https://github.com/Metta-AI/coworld-heartleaf/tree/master/commissioner",
      "image": "{{COMMISSIONER_IMAGE}}"
    }
  ],
  "reporter": [],
  "grader": [
    {
      "id": "bitworld-score-grader",
      "name": "BitWorld Score Grader",
      "type": "grader",
      "description": "Generic BitWorld grader that scores episode interest from score spread and game-specific activity signals.",
      "source_url": "https://github.com/Metta-AI/coworld-heartleaf/tree/master/grader/graders/bitworld_score/bitworld_score_grader",
      "image": "{{GRADER_IMAGE}}"
    }
  ],
  "variants": [
    {
      "id": "league",
      "name": "League",
      "game_config": {
        "seed": 4731713,
        "maxTicks": 31920,
        "maxGames": 1,
        "daySeconds": 180,
        "players": [
          {
            "name": "Villager 1"
          },
          {
            "name": "Villager 2"
          },
          {
            "name": "Villager 3"
          },
          {
            "name": "Villager 4"
          },
          {
            "name": "Villager 5"
          },
          {
            "name": "Villager 6"
          },
          {
            "name": "Villager 7"
          },
          {
            "name": "Villager 8"
          },
          {
            "name": "Villager 9"
          }
        ]
      },
      "description": "Seven Heartleaf days of three minutes each (21 minutes of play) for hosted league rounds. Seed 4731713 is unpinned: each episode draws a fresh village RNG."
    },
    {
      "id": "freeplay",
      "name": "Freeplay",
      "game_config": {
        "seed": 4731713,
        "maxTicks": 0,
        "maxGames": 0
      },
      "description": "Open-ended Heartleaf configuration for local player testing."
    },
    {
      "id": "smoke",
      "name": "Smoke",
      "game_config": {
        "seed": 1,
        "maxTicks": 300,
        "maxGames": 1
      },
      "description": "Short deterministic Heartleaf configuration used for smoke checks."
    }
  ],
  "certification": {
    "game_config": {
      "seed": 1,
      "maxTicks": 300,
      "maxGames": 1
    },
    "players": [
      {
        "player_id": "shy_villager"
      },
      {
        "player_id": "shy_villager"
      },
      {
        "player_id": "shy_villager"
      },
      {
        "player_id": "chatty_villager"
      },
      {
        "player_id": "chatty_villager"
      },
      {
        "player_id": "friendly_villager"
      },
      {
        "player_id": "friendly_villager"
      },
      {
        "player_id": "fatherly_villager"
      },
      {
        "player_id": "fatherly_villager"
      }
    ]
  },
  "players_per_user": 9,
  "episode_timeout_minutes": 60
}
