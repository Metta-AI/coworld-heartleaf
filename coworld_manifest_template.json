{
  "$schema": "https://raw.githubusercontent.com/Metta-AI/metta/main/packages/coworld/src/coworld/coworld_manifest_schema.json",
  "tags": [
    "garden",
    "multiplayer",
    "social"
  ],
  "game": {
    "name": "heartleaf",
    "replay_viewer": {
      "bundle": "build/static-replay-viewer"
    },
    "description": "A cozy BitWorld garden dinner game where players grow food, collect vegetables, and gather in the evening.",
    "owner": "treeform@softmax.com",
    "runnable": {
      "type": "game",
      "image": "{{GAME_IMAGE}}",
      "run": [
        "/bin/heartleaf"
      ],
      "source_url": "https://github.com/Metta-AI/coworld-heartleaf/tree/master"
    },
    "config_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokens"
      ],
      "properties": {
        "tokens": {
          "description": "One connection token per player slot, indexed by slot.",
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "type": "string",
            "minLength": 0
          },
          "default": [
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            ""
          ]
        },
        "seed": {
          "description": "Random seed.",
          "type": "integer",
          "minimum": 0,
          "default": 4731713
        },
        "maxTicks": {
          "description": "Maximum simulation ticks before starting a fresh game, where 0 means no tick limit.",
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "maxGames": {
          "description": "Maximum fresh games before shutdown, where 0 means no game limit.",
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "num_agents": {
          "description": "Player seat count used by hosted league seating.",
          "type": "integer",
          "minimum": 1,
          "maximum": 9,
          "default": 9
        },
        "daySeconds": {
          "description": "Real seconds per in-game day, before the 10-second score screen.",
          "type": "integer",
          "minimum": 30,
          "maximum": 600,
          "default": 180
        }
      }
    },
    "results_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "day",
        "names",
        "usernames",
        "playerNames",
        "scores"
      ],
      "properties": {
        "day": {
          "description": "One-based Heartleaf day number for this score row.",
          "type": "integer",
          "minimum": 1
        },
        "names": {
          "description": "Player names in score order.",
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "type": "string"
          }
        },
        "usernames": {
          "description": "Connection usernames in score order.",
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "type": "string"
          }
        },
        "playerNames": {
          "description": "Fixed Heartleaf gnome names in score order.",
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "type": "string"
          }
        },
        "scores": {
          "description": "Cumulative player scores at the end of this day.",
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "protocols": {
      "global": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/bitworld/blob/master/docs/sprite_v1.md"
      },
      "player": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/bitworld/blob/master/docs/sprite_v1.md"
      }
    },
    "docs": {
      "readme": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/coworld-heartleaf/blob/master/README.md"
      },
      "pages": [
        {
          "id": "rules.md",
          "title": "rules.md",
          "content": {
            "type": "uri",
            "value": "https://github.com/Metta-AI/coworld-heartleaf/blob/master/docs/rules.md"
          }
        },
        {
          "id": "play_heartleaf.md",
          "title": "play_heartleaf.md",
          "content": {
            "type": "uri",
            "value": "https://github.com/Metta-AI/coworld-heartleaf/blob/master/docs/play_heartleaf.md"
          }
        }
      ]
    }
  },
  "player": [
    {
      "id": "shy_villager",
      "name": "Shy Villager",
      "type": "player",
      "description": "Shy LLM-guided Heartleaf gnome that gathers quietly, speaks softly, and honors party invitations.",
      "image": "{{SHY_VILLAGER_IMAGE}}",
      "run": [
        "/bin/shy_villager"
      ],
      "env": {
        "TALKING_VILLAGER_MOCK_REPLY": "{\"action\": \"keep_gathering_plants\"}"
      },
      "source_url": "https://github.com/Metta-AI/coworld-heartleaf/tree/master/players/shy_villager"
    },
    {
      "id": "chatty_villager",
      "name": "Chatty Villager",
      "type": "player",
      "description": "Chatty LLM-guided Heartleaf gnome that greets everyone, talks constantly, and spreads party invitations.",
      "image": "{{CHATTY_VILLAGER_IMAGE}}",
      "run": [
        "/bin/chatty_villager"
      ],
      "env": {
        "TALKING_VILLAGER_MOCK_REPLY": "{\"action\": \"keep_gathering_plants\"}"
      },
      "source_url": "https://github.com/Metta-AI/coworld-heartleaf/tree/master/players/chatty_villager"
    },
    {
      "id": "friendly_villager",
      "name": "Friendly Villager",
      "type": "player",
      "description": "Friendly LLM-guided Heartleaf gnome that welcomes everyone, shares food, and hosts warm dinners.",
      "image": "{{FRIENDLY_VILLAGER_IMAGE}}",
      "run": [
        "/bin/friendly_villager"
      ],
      "env": {
        "TALKING_VILLAGER_MOCK_REPLY": "{\"action\": \"keep_gathering_plants\"}"
      },
      "source_url": "https://github.com/Metta-AI/coworld-heartleaf/tree/master/players/friendly_villager"
    },
    {
      "id": "fatherly_villager",
      "name": "Fatherly Villager",
      "type": "player",
      "description": "Fatherly LLM-guided Heartleaf gnome that checks on others, shares food, and makes sure nobody dines alone.",
      "image": "{{FATHERLY_VILLAGER_IMAGE}}",
      "run": [
        "/bin/fatherly_villager"
      ],
      "env": {
        "TALKING_VILLAGER_MOCK_REPLY": "{\"action\": \"keep_gathering_plants\"}"
      },
      "source_url": "https://github.com/Metta-AI/coworld-heartleaf/tree/master/players/fatherly_villager"
    }
  ],
  "commissioner": [
    {
      "id": "default-commissioner",
      "name": "Default Commissioner",
      "type": "commissioner",
      "description": "Game-agnostic round-robin commissioner with mean-score rankings.",
      "source_url": "https://github.com/Metta-AI/commissioners/tree/fa8ac7cb2bc6fd54c5675c7993919afabebcf4ba/commissioners/ruleset_strategy_commissioner",
      "image": "{{COMMISSIONER_IMAGE}}"
    }
  ],
  "reporter": [],
  "grader": [
    {
      "id": "bitworld-score-grader",
      "name": "BitWorld Score Grader",
      "type": "grader",
      "description": "Generic BitWorld grader that scores episode interest from score spread and game-specific activity signals.",
      "source_url": "https://github.com/Metta-AI/coworld-heartleaf/tree/master/grader/graders/bitworld_score/bitworld_score_grader",
      "image": "{{GRADER_IMAGE}}"
    }
  ],
  "variants": [
    {
      "id": "league",
      "name": "League",
      "game_config": {
        "seed": 4731713,
        "maxTicks": 23760,
        "maxGames": 1,
        "num_agents": 9,
        "daySeconds": 100
      },
      "description": "Nine compressed Heartleaf days (100s each) so every gnome gets a hosting turn, used for hosted league rounds."
    },
    {
      "id": "freeplay",
      "name": "Freeplay",
      "game_config": {
        "seed": 4731713,
        "maxTicks": 0,
        "maxGames": 0
      },
      "description": "Open-ended Heartleaf configuration for local player testing."
    },
    {
      "id": "smoke",
      "name": "Smoke",
      "game_config": {
        "seed": 4731713,
        "maxTicks": 300,
        "maxGames": 1
      },
      "description": "Short deterministic Heartleaf configuration used for smoke checks."
    }
  ],
  "certification": {
      "game_config": {
        "seed": 4731713,
        "maxTicks": 300,
        "maxGames": 1
      },
    "players": [
      {
        "player_id": "shy_villager"
      },
      {
        "player_id": "shy_villager"
      },
      {
        "player_id": "shy_villager"
      },
      {
        "player_id": "chatty_villager"
      },
      {
        "player_id": "chatty_villager"
      },
      {
        "player_id": "friendly_villager"
      },
      {
        "player_id": "friendly_villager"
      },
      {
        "player_id": "fatherly_villager"
      },
      {
        "player_id": "fatherly_villager"
      }
    ]
  },
  "players_per_user": 9
}
